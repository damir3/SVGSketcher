{
  "name": "svg-sketcher",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:kernel": "node scripts/build-kernel.mjs",
    "build:wasm": "npm run build:kernel && tsc && vite build --mode wasm",
    "preview": "vite preview",
    "bench:scenes": "node --import tsx benchmarks/node.mjs --scenes",
    "bench:node": "node --import tsx benchmarks/node.mjs",
    "bench:build": "npm run build:kernel && tsc -p benchmarks/tsconfig.json && vite build --config benchmarks/vite.config.ts",
    "bench:serve": "vite preview --config benchmarks/vite.config.ts",
    "test": "tsx --test test/*.test.ts",
    "test:rust": "cargo test --locked --workspace",
    "test:wasm": "node --import tsx --import ./test/helpers/wasmKernel.ts --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "lint": "biome format src",
    "check": "npm run typecheck && npm run format:check && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@types/opentype.js": "^1.3.10",
    "opentype.js": "^2.0.0"
  }
}
